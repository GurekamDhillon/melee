    "file": {
     "type": "string",
     "pattern": "^(?!.*\\.\\.)[^\\\\:]+$",
     "description": "mod-relative words file (whitespace/comma separated numbers, '#' comments); '..' refused"
    },
    "move_tag": {
     "enum": [
      "jab",
      "dash_attack",
      "tilt",
      "smash",
      "aerial",
      "grab",
      "throw",
      "special",
      "projectile"
     ]
    }
