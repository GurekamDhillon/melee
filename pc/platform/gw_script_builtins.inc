    "  -- a title in the kit's 'label' role, an icon beside it, a caption under it\n"
    "  gd.kit.icon(\"training\", x + 14, y + 12, 0.25, \"gold\") -- ico_training: 128 px at 1x, drawn at 32\n"
    "  gd.kit.text(x + 50, y + 34, \"MATCH\", \"label\", \"bone\")\n"
