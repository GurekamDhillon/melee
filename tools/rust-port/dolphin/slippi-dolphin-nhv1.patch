diff --git a/Source/Core/Core/Slippi/NHV1Oracle.cpp b/Source/Core/Core/Slippi/NHV1Oracle.cpp
new file mode 100644
index 0000000..17a3fc2
--- /dev/null
+++ b/Source/Core/Core/Slippi/NHV1Oracle.cpp
@@ -0,0 +1,517 @@
+// NHV1 oracle (GD's Melee port, local tool): see NHV1Oracle.h.
+#include "Core/Slippi/NHV1Oracle.h"
+
+#include <climits>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <chrono>
+#include <thread>
+#include <vector>
+
+#include "Core/PowerPC/PowerPC.h"
+
+#include "Core/Core.h"
+#include "Core/HW/Memmap.h"
+#include "Core/PowerPC/MMU.h"
+#include "Core/System.h"
+
+namespace NHV1Oracle
+{
+namespace
+{
+// config/GALE01/symbols.txt
+constexpr u32 PLAYER_SLOTS = 0x80453080;  // StaticPlayer[6], 0xE90 each
+constexpr u32 PLAYER_SIZE = 0xE90;
+constexpr u32 HSD_RAND_SEED_PTR = 0x804D5F94;
+constexpr u32 HSD_GOBJ_PLINK_HEAD = 0x804D782C;
+constexpr u32 GM_80479D58 = 0x80479D58;
+constexpr u32 GAME_CAMERA = 0x80452C68;
+constexpr u32 GAME_CAMERA_SIZE = 0x39C;
+constexpr u32 STAGE_INFO = 0x8049E6C8;
+constexpr u32 STAGE_INFO_SIZE = 0x748;
+constexpr u32 FIGHTER_SIZE = 0x23EC;  // ASSERT_SIZE(struct Fighter, 0x23EC)
+constexpr u32 ITEM_SIZE = 0xFCC;      // ASSERT_SIZE(struct Item, 0xFCC)
+constexpr u32 PLINK_ITEM = 9;         // HSD_GOBJ_PLINK_ITEM
+constexpr u32 MAX_ITEMS = 512;
+
+int s_state = -1;  // -1 unread, 0 off, 1 on
+bool s_wide = false;
+bool s_exit = false;
+FILE* s_out = nullptr;
+s32 s_frame = INT_MIN;
+s32 s_latest = INT_MIN;
+bool s_complete = false;
+s32 s_logged = INT_MIN;
+
+void Init()
+{
+  if (s_state >= 0)
+    return;
+  s_state = 0;
+  const char* path = std::getenv("MELEE_DOLPHIN_NHV1");
+  if (!path || !*path)
+    return;
+  s_out = std::fopen(path, "wb");
+  if (!s_out)
+  {
+    std::fprintf(stderr, "nhv1-oracle: cannot open the output file\n");
+    return;
+  }
+  const char* w = std::getenv("MELEE_DOLPHIN_NHV1_WIDE");
+  s_wide = w && *w && *w != '0';
+  const char* x = std::getenv("MELEE_DOLPHIN_NHV1_EXIT");
+  s_exit = x && *x && *x != '0';
+  std::fwrite("NHRAW001", 1, 8, s_out);
+  const u32 flags = s_wide ? 1 : 0;
+  std::fwrite(&flags, 4, 1, s_out);
+  s_state = 1;
+  std::fprintf(stderr, "nhv1-oracle: on (wide=%d)\n", s_wide ? 1 : 0);
+}
+
+bool InRam(u32 a)
+{
+  return a >= 0x80000000 && a < 0x81800000;
+}
+
+void Put32(std::vector<u8>& b, u32 v)
+{
+  const u8* p = reinterpret_cast<const u8*>(&v);
+  b.insert(b.end(), p, p + 4);
+}
+
+void PutBlob(std::vector<u8>& b, Memory::MemoryManager& mem, u32 addr, u32 size)
+{
+  const size_t at = b.size();
+  b.resize(at + size);
+  mem.CopyFromEmu(b.data() + at, addr, size);
+}
+}  // namespace
+
+bool Enabled()
+{
+  Init();
+  return s_state == 1;
+}
+
+void NoteFrame(s32 frame, s32 latest, bool processing_complete)
+{
+  if (s_state == 1 && (s_frame == INT_MIN || frame < -100 || frame % 1200 == 0))
+    std::fprintf(stderr, "nhv1-oracle: playback frame %d (latest %d)\n", frame, latest);
+  if (s_frame == INT_MIN && s_state == 1 && std::getenv("MELEE_DOLPHIN_NHV1_WATCHDOG"))
+  {
+    std::thread([] {
+      auto& sys = Core::System::GetInstance();
+      for (int i = 0; i < 60; i++)
+      {
+        std::this_thread::sleep_for(std::chrono::seconds(2));
+        std::fprintf(stderr, "nhv1-oracle: watchdog pc=%08x lr=%08x unk0=%u frame=%d\n",
+                     sys.GetPPCState().pc, sys.GetPPCState().spr[8],
+                     sys.GetMemory().Read_U32(GM_80479D58), s_frame);
+        std::fflush(stderr);
+      }
+    }).detach();
+  }
+  s_frame = frame;
+  s_latest = latest;
+  s_complete = processing_complete;
+}
+
+// GD slippi-p1: MELEE_DOLPHIN_STATELOG=<file> writes one line per logic frame (any scene): gm_80479D58.unk_0, the
+// scene bytes at 0x80479D30 and the u32s at MELEE_DOLPHIN_STATELOG_ADDRS (hex, comma separated)
+bool StateLogOn()
+{
+  const char* p = std::getenv("MELEE_DOLPHIN_STATELOG");
+  return p && *p;
+}
+static void StateLog(const Core::CPUThreadGuard& guard)
+{
+  static FILE* f = nullptr;
+  static std::vector<u32> addrs;
+  static bool tried = false;
+  if (!tried)
+  {
+    tried = true;
+    if (StateLogOn())
+      f = std::fopen(std::getenv("MELEE_DOLPHIN_STATELOG"), "w");
+    if (const char* a = std::getenv("MELEE_DOLPHIN_STATELOG_ADDRS"))
+    {
+      std::string s(a);
+      size_t i = 0;
+      while (i < s.size())
+      {
+        size_t j = s.find(',', i);
+        if (j == std::string::npos)
+          j = s.size();
+        addrs.push_back(static_cast<u32>(std::strtoul(s.substr(i, j - i).c_str(), nullptr, 16)));
+        i = j + 1;
+      }
+    }
+  }
+  if (!f)
+    return;
+  std::fprintf(f, "%u %08x", PowerPC::MMU::HostRead_U32(guard, GM_80479D58),
+               PowerPC::MMU::HostRead_U32(guard, 0x80479D30));
+  for (u32 a : addrs)
+    std::fprintf(f, " %08x", PowerPC::MMU::HostRead_U32(guard, a));
+  std::fputc(10, f);
+  std::fflush(f);
+}
+
+void FrameEnd(const Core::CPUThreadGuard& guard)
+{
+  StateLog(guard);
+  if (!Enabled())
+    return;
+  static u32 s_calls = 0;
+  if (s_calls++ % 3600 == 0)
+  {
+    std::fprintf(stderr, "nhv1-oracle: hook call %u, playback frame %d\n", s_calls, s_frame);
+    std::fflush(stderr);
+  }
+  if (s_frame == INT_MIN || s_frame == s_logged)
+    return;
+  auto& mem = guard.GetSystem().GetMemory();
+  auto r32 = [&](u32 a) { return PowerPC::MMU::HostRead_U32(guard, a); };
+  auto r8 = [&](u32 a) { return PowerPC::MMU::HostRead_U8(guard, a); };
+
+  std::vector<u8> fighters;
+  u32 n_ft = 0;
+  for (u32 i = 0; i < 6; i++)
+  {
+    const u32 pl = PLAYER_SLOTS + i * PLAYER_SIZE;
+    for (u32 j = 0; j < 2; j++)
+    {
+      // Player_GetEntityAtIndex(i, j) = player_entity[transformed[j]]
+      const u8 t = r8(pl + 0x0C + j);
+      if (t > 1)
+        continue;
+      const u32 g = r32(pl + 0xB0 + 4 * t);
+      if (!InRam(g))
+        continue;
+      const u32 fp = r32(g + 0x2C);  // HSD_GObj::user_data
+      if (!InRam(fp))
+        continue;
+      fighters.push_back(static_cast<u8>(i * 2 + j));
+      fighters.push_back(static_cast<u8>(r32(pl + 0x08)));  // pkind (Gm_PKind_Cpu = 1)
+      fighters.push_back(r8(pl + 0x8E));                     // stocks (s8)
+      fighters.push_back(t);
+      Put32(fighters, fp);
+      PutBlob(fighters, mem, fp, FIGHTER_SIZE);
+      n_ft++;
+      // GD nhv1-oracle: MELEE_DOLPHIN_NHV1_BONES=<txt> (frames _BONES_FROM.._BONES_TO): each part's jobj world
+      // matrix, fp->parts[i].joint->mtx (jobj+0x44), parts_num = ftPartsTable[fp->kind]->parts_num
+      static FILE* bf = nullptr;
+      static bool btried = false;
+      static int bfrom = INT_MIN, bto = INT_MAX;
+      if (!btried)
+      {
+        btried = true;
+        const char* bp = std::getenv("MELEE_DOLPHIN_NHV1_BONES");
+        if (bp && *bp)
+          bf = std::fopen(bp, "w");
+        if (const char* a = std::getenv("MELEE_DOLPHIN_NHV1_BONES_FROM"))
+          bfrom = std::atoi(a);
+        if (const char* b = std::getenv("MELEE_DOLPHIN_NHV1_BONES_TO"))
+          bto = std::atoi(b);
+      }
+      if (bf && s_frame >= bfrom && s_frame <= bto)
+      {
+        const u32 tbl = r32(0x804D6544);
+        const u32 kind = r32(fp + 0x4);
+        const u32 ent = InRam(tbl) ? r32(tbl + 4 * kind) : 0;
+        const u32 parts = r32(fp + 0x5E8);
+        if (InRam(ent) && InRam(parts))
+        {
+          const u32 np = r32(ent + 8);
+          for (u32 k = 0; k < np && k < 256; k++)
+          {
+            const u32 jo = r32(parts + 0x10 * k);
+            if (!InRam(jo))
+              continue;
+            for (u32 n = 0; n < 12; n++)
+              std::fprintf(bf, "%d s%u bone[%u].mtx[%u] %08x\n", s_frame, i * 2 + j, k, n, r32(jo + 0x44 + 4 * n));
+            std::fprintf(bf, "%d s%u bone[%u].in[0] %08x\n", s_frame, i * 2 + j, k, r32(jo + 0x14));
+            for (u32 n = 0; n < 10; n++)
+              std::fprintf(bf, "%d s%u bone[%u].in[%u] %08x\n", s_frame, i * 2 + j, k, n + 1, r32(jo + 0x1C + 4 * n));
+          }
+          std::fflush(bf);
+        }
+      }
+    }
+  }
+  if (n_ft == 0)
+  {
+    return;
+  }  // the frame-0 rule: rows start at the first iteration with a fighter
+
+  std::vector<u8> items;
+  u32 n_it = 0;
+  const u32 heads = r32(HSD_GOBJ_PLINK_HEAD);
+  if (InRam(heads))
+  {
+    for (u32 g = r32(heads + 4 * PLINK_ITEM); InRam(g) && n_it < MAX_ITEMS; g = r32(g + 0x08))
+    {
+      const u32 ip = r32(g + 0x2C);
+      if (!InRam(ip))
+        continue;
+      Put32(items, ip);
+      PutBlob(items, mem, ip, ITEM_SIZE);
+      n_it++;
+    }
+  }
+
+  std::vector<u8> rec;
+  Put32(rec, 0x4D524652);  // "RFRM"
+  Put32(rec, static_cast<u32>(s_frame));
+  Put32(rec, r32(GM_80479D58));
+  const u32 seed_ptr = r32(HSD_RAND_SEED_PTR);
+  Put32(rec, InRam(seed_ptr) ? r32(seed_ptr) : 0);
+  Put32(rec, n_ft);
+  Put32(rec, n_it);
+  rec.insert(rec.end(), fighters.begin(), fighters.end());
+  rec.insert(rec.end(), items.begin(), items.end());
+  if (s_wide)
+  {
+    PutBlob(rec, mem, GAME_CAMERA, GAME_CAMERA_SIZE);
+    PutBlob(rec, mem, STAGE_INFO, STAGE_INFO_SIZE);
+  }
+  std::fwrite(rec.data(), 1, rec.size(), s_out);
+  s_logged = s_frame;
+
+  static const char* stop_env = std::getenv("MELEE_DOLPHIN_NHV1_STOP_AT");
+  if (stop_env && *stop_env && s_frame >= std::atoi(stop_env))
+  {
+    std::fclose(s_out);
+    s_out = nullptr;
+    std::fprintf(stderr, "nhv1-oracle: stop frame %d reached, exiting\n", s_frame);
+    std::fflush(stderr);
+    std::_Exit(0);
+  }
+  if (s_exit && s_complete && s_frame >= s_latest)
+  {
+    std::fclose(s_out);
+    s_out = nullptr;
+    std::fprintf(stderr, "nhv1-oracle: last frame %d logged, exiting\n", s_frame);
+    std::fflush(stderr);
+    std::_Exit(0);
+  }
+}
+std::vector<u32> ProbeAddresses()
+{
+  std::vector<u32> out;
+  const char* at = std::getenv("MELEE_DOLPHIN_NHV1_PROBE_AT");
+  if (!at)
+    return out;
+  const char* p = at;
+  while (*p)
+  {
+    char* end = nullptr;
+    const unsigned long v = std::strtoul(p, &end, 16);
+    if (end == p)
+      break;
+    out.push_back(static_cast<u32>(v));
+    p = (*end == ',') ? end + 1 : end;
+  }
+  return out;
+}
+
+void Probe(const Core::CPUThreadGuard& guard)
+{
+  static FILE* f = nullptr;
+  static bool tried = false;
+  static int mem_reg = -1;
+  static u32 mem_off = 0, mem_len = 0;
+  static int ch_reg = -1;
+  static u32 ch_next = 0, ch_len = 0, ch_max = 0;
+  if (!tried)
+  {
+    tried = true;
+    const char* path = std::getenv("MELEE_DOLPHIN_NHV1_PROBE");
+    if (path && *path)
+      f = std::fopen(path, "w");
+    const char* m = std::getenv("MELEE_DOLPHIN_NHV1_PROBE_MEM");
+    unsigned r = 0, off = 0, len = 0;
+    if (m && std::sscanf(m, "r%u+0x%x:0x%x", &r, &off, &len) == 3 && r < 32 && len <= 0x4000)
+    {
+      mem_reg = static_cast<int>(r);
+      mem_off = off;
+      mem_len = len;
+    }
+    // MELEE_DOLPHIN_NHV1_PROBE_CHAIN=rN:0xNEXT:0xLEN:COUNT walks a linked list from register N (each node's next
+    // pointer at +NEXT) and dumps LEN bytes of up to COUNT nodes
+    const char* c = std::getenv("MELEE_DOLPHIN_NHV1_PROBE_CHAIN");
+    unsigned cn = 0, cl = 0, cc = 0;
+    if (c && std::sscanf(c, "r%u:0x%x:0x%x:%u", &r, &cn, &cl, &cc) == 4 && r < 32 && cl <= 0x1000 && cc <= 256)
+    {
+      ch_reg = static_cast<int>(r);
+      ch_next = cn;
+      ch_len = cl;
+      ch_max = cc;
+    }
+  }
+  if (!f)
+    return;
+  auto& ppc = guard.GetSystem().GetPPCState();
+  auto fb = [&](int i) {
+    const float x = static_cast<float>(ppc.ps[i].PS0AsDouble());
+    u32 b;
+    std::memcpy(&b, &x, 4);
+    return b;
+  };
+  std::fprintf(f, "probe frame=%d pc=%08x lr=%08x r3=%08x r4=%08x r5=%08x r6=%08x r29=%08x r30=%08x r31=%08x f1=%08x f2=%08x f3=%08x f4=%08x f5=%08x f6=%08x",
+               s_frame, ppc.pc, ppc.spr[SPR_LR], ppc.gpr[3], ppc.gpr[4], ppc.gpr[5], ppc.gpr[6], ppc.gpr[29], ppc.gpr[30],
+               ppc.gpr[31], fb(1), fb(2), fb(3), fb(4), fb(5), fb(6));
+  if (mem_reg >= 0)
+  {
+    std::fprintf(f, " mem=");
+    const u32 base = ppc.gpr[mem_reg] + mem_off;
+    for (u32 k = 0; k < mem_len; k++)
+      std::fprintf(f, "%02x", PowerPC::MMU::HostRead_U8(guard, base + k));
+  }
+  if (ch_reg >= 0)
+  {
+    u32 p = ppc.gpr[ch_reg];
+    for (u32 n = 0; n < ch_max && p >= 0x80000000u && p < 0x81800000u; n++)
+    {
+      std::fprintf(f, " node%u@%08x=", n, p);
+      for (u32 k = 0; k < ch_len; k++)
+        std::fprintf(f, "%02x", PowerPC::MMU::HostRead_U8(guard, p + k));
+      p = PowerPC::MMU::HostRead_U32(guard, p + ch_next);
+    }
+  }
+  std::fputc('\n', f);
+  std::fflush(f);
+}
+// GD nhv1-oracle: Slippi's playback code injected at Fighter_procInput 0x8006B0DC writes, on the first playback
+// frame only, fp->coll_data.cur_pos/last_pos from fp->cur_pos and coll_data.x38 from the line counter. The recording
+// console does not (its Post-Frame y at the landing frame keeps the unrestored value), so the oracle saves those
+// fields before the injection and puts them back after it (MELEE_DOLPHIN_NHV1_KEEP_PLAYBACK_INIT=1 keeps the write).
+static u8 s_undo_buf[8][0x38];
+static u32 s_undo_fp[8];
+static int s_undo_n = 0;
+static s32 s_undo_frame = INT_MIN;
+// The same injection also calls Camera_8002F3AC (snap the camera to its target) once per fighter on that frame; the
+// recording console never did, so game_camera (0x80452C68, 0x39C bytes) is saved at the first fighter and restored.
+static u8 s_undo_cam[0x39C];
+static bool s_undo_cam_saved = false;
+void UndoSave(const Core::CPUThreadGuard& guard)
+{
+  if (s_state != 1 || std::getenv("MELEE_DOLPHIN_NHV1_KEEP_PLAYBACK_INIT"))
+    return;
+  if (s_undo_frame != s_frame)
+  {
+    s_undo_frame = s_frame;
+    s_undo_n = 0;
+    s_undo_cam_saved = false;
+  }
+  if (s_frame != -123 || s_undo_n >= 8)
+    return;
+  if (!s_undo_cam_saved && !std::getenv("MELEE_DOLPHIN_NHV1_KEEP_PLAYBACK_CAMERA"))
+  {
+    for (u32 k = 0; k < 0x39C; k++)
+      s_undo_cam[k] = PowerPC::MMU::HostRead_U8(guard, 0x80452C68 + k);
+    s_undo_cam_saved = true;
+  }
+  const u32 fp = guard.GetSystem().GetPPCState().gpr[31];
+  s_undo_fp[s_undo_n] = fp;
+  for (u32 k = 0; k < 0x38; k++)
+    s_undo_buf[s_undo_n][k] = PowerPC::MMU::HostRead_U8(guard, fp + 0x6F4 + k);
+  s_undo_n++;
+}
+void UndoRestore(const Core::CPUThreadGuard& guard)
+{
+  if (s_state != 1 || s_frame != -123 || s_undo_n == 0)
+    return;
+  const u32 fp = guard.GetSystem().GetPPCState().gpr[31];
+  for (int i = 0; i < s_undo_n; i++)
+  {
+    if (s_undo_fp[i] != fp)
+      continue;
+    for (u32 k = 0; k < 0x38; k++)
+      PowerPC::MMU::HostWrite_U8(guard, s_undo_buf[i][k], fp + 0x6F4 + k);
+    s_undo_fp[i] = 0;
+  }
+  if (s_undo_cam_saved)
+    for (u32 k = 0; k < 0x39C; k++)
+      PowerPC::MMU::HostWrite_U8(guard, s_undo_cam[k], 0x80452C68 + k);
+}
+}  // namespace NHV1Oracle
+
+#ifdef _WIN32
+// GD nhv1-oracle: diagnostics for silent fast-fails (write to %TEMP%\nhv1-oracle-crash.txt)
+#include <Windows.h>
+#include <csignal>
+#include <exception>
+namespace
+{
+
+void CrashNote(const char* what)
+{
+  char path[MAX_PATH];
+  DWORD n = GetTempPathA(MAX_PATH, path);
+  if (n == 0 || n > MAX_PATH - 32)
+    return;
+  strcat_s(path, "nhv1-oracle-crash.txt");
+  FILE* f = nullptr;
+  if (fopen_s(&f, path, "a") != 0 || !f)
+    return;
+  void* frames[48];
+  USHORT k = CaptureStackBackTrace(1, 48, frames, nullptr);
+  const uintptr_t base = reinterpret_cast<uintptr_t>(GetModuleHandleA(nullptr));
+  std::fprintf(f, "%s (exe base %p)\n", what, reinterpret_cast<void*>(base));
+  for (USHORT i = 0; i < k; i++)
+  {
+    HMODULE m = nullptr;
+    GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                       static_cast<LPCSTR>(frames[i]), &m);
+    char mod[MAX_PATH] = "?";
+    if (m)
+      GetModuleFileNameA(m, mod, MAX_PATH);
+    std::fprintf(f, "  %s+0x%llx\n", mod,
+                 static_cast<unsigned long long>(reinterpret_cast<uintptr_t>(frames[i]) - reinterpret_cast<uintptr_t>(m)));
+  }
+  std::fclose(f);
+}
+void OnInvalidParam(const wchar_t* expr, const wchar_t* fn, const wchar_t* file, unsigned line, uintptr_t)
+{
+  char b[512];
+  snprintf(b, sizeof b, "invalid parameter: %ls in %ls (%ls:%u)", expr ? expr : L"?", fn ? fn : L"?",
+           file ? file : L"?", line);
+  CrashNote(b);
+}
+void OnAbort(int)
+{
+  CrashNote("SIGABRT");
+}
+void OnTerminate()
+{
+  try
+  {
+    if (auto e = std::current_exception())
+      std::rethrow_exception(e);
+    CrashNote("terminate, no exception");
+  }
+  catch (const std::exception& e)
+  {
+    char b[512];
+    snprintf(b, sizeof b, "terminate: %s", e.what());
+    CrashNote(b);
+  }
+  catch (...)
+  {
+    CrashNote("terminate: unknown exception");
+  }
+  std::abort();
+}
+struct Install
+{
+  Install()
+  {
+    _set_invalid_parameter_handler(OnInvalidParam);
+    signal(SIGABRT, OnAbort);
+    std::set_terminate(OnTerminate);
+  }
+} s_install;
+}  // namespace
+#endif
