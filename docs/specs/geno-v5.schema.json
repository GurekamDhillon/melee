{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://gdmelee.invalid/specs/geno-v5.schema.json",
 "title": "Geno geno.json, format v5 (v1-v5.5 keys) with later keys tolerated",
 "description": "docs/specs/geno-v5.md. Root = a mods/<id>/geno.json. $defs.gfxPackage and $defs.fxBindings validate the effect files. Readers ignore unknown keys; the schema allows them everywhere except where a closed key set is documented (attributes, parameter families). Readers also tolerate // comments and trailing commas, which strict JSON (and this schema) does not.",
 "type": "object",
 "required": [
  "geno",
  "fighters"
 ],
 "properties": {
  "geno": {
   "type": "integer",
   "minimum": 1,
   "description": "format version; v5 files write 5; a reader newer than the file reads it, an older reader logs and reads what it knows"
  },
  "fighters": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/fighter"
   }
  }
 },
 "x-attach-names": [
  "mario",
  "fox",
  "captain",
  "falcon",
  "donkey",
  "dk",
  "kirby",
  "koopa",
  "bowser",
  "link",
  "seak",
  "sheik",
  "ness",
  "peach",
  "popo",
  "nana",
  "pikachu",
  "samus",
  "yoshi",
  "purin",
  "jigglypuff",
  "mewtwo",
  "luigi",
  "mars",
  "marth",
  "zelda",
  "clink",
  "younglink",
  "drmario",
  "falco",
  "pichu",
  "gamewatch",
  "gnw",
  "ganon",
  "ganondorf",
  "emblem",
  "roy"
 ],
 "$defs": {
  "word": {
   "description": "One script word: an integer in -2^31..2^32-1, or a string '0x..' / decimal (strtoull, <= 0xFFFFFFFF).",
   "oneOf": [
    {
     "type": "integer",
     "minimum": -2147483648,
     "maximum": 4294967295
    },
    {
     "type": "string",
     "pattern": "^(0[xX][0-9a-fA-F]{1,8}|[0-9]{1,10})$"
    }
   ]
  },
  "target": {
   "description": "A target: motion id 0..65535, 'motion:N', 'special:N', 'geno:N', 'geno:<state name>', 'auto', 'helpless', 'stay' (stay: only for 'land'). Readers match case-insensitively; canonical form is lower case.",
   "oneOf": [
    {
     "type": "integer",
     "minimum": 0,
     "maximum": 65535
    },
    {
     "type": "string",
     "pattern": "^(auto|helpless|stay)$"
    },
    {
     "type": "string",
     "pattern": "^(motion|special|geno):(0[xX][0-9a-fA-F]+|[0-9]+)$"
    },
    {
     "type": "string",
     "pattern": "^geno:[A-Za-z_][A-Za-z0-9_]*$"
    }
   ]
  },
  "hookRef": {
   "type": "string",
   "pattern": "^(geno\\.log|geno\\.jumps\\.refill|geno\\.jumps\\.to_var|geno\\.count_frames|geno\\.article\\.spawn|geno\\.lockon|geno\\.aim_stick|geno\\.dash\\.search|geno\\.dash\\.aim|geno\\.brake)(:-?[0-9]+)?$",
   "description": "'name' or 'name:arg' (arg via atoi; default 0). Names are the stable hook table (geno.h GENO_HOOK_*)."
  },
  "hooks": {
   "type": "object",
   "properties": {
    "on_init": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/hookRef"
     },
     "maxItems": 8
    },
    "on_frame": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/hookRef"
     },
     "maxItems": 8
    },
    "on_action": {
     "type": "array",
