diff --git a/Source/Core/Core/Slippi/NHV1Oracle.cpp b/Source/Core/Core/Slippi/NHV1Oracle.cpp
new file mode 100644
index 0000000..bfbe1ae
--- /dev/null
+++ b/Source/Core/Core/Slippi/NHV1Oracle.cpp
@@ -0,0 +1,286 @@
+// NHV1 oracle (GD's Melee port, local tool): see NHV1Oracle.h.
+#include "Core/Slippi/NHV1Oracle.h"
+
+#include <climits>
+#include <cstdio>
+#include <cstdlib>
+#include <chrono>
+#include <thread>
+#include <vector>
+
+#include "Core/PowerPC/PowerPC.h"
+
+#include "Core/Core.h"
+#include "Core/HW/Memmap.h"
+#include "Core/PowerPC/MMU.h"
+#include "Core/System.h"
+
+namespace NHV1Oracle
+{
+namespace
+{
+// config/GALE01/symbols.txt
+constexpr u32 PLAYER_SLOTS = 0x80453080;  // StaticPlayer[6], 0xE90 each
+constexpr u32 PLAYER_SIZE = 0xE90;
+constexpr u32 HSD_RAND_SEED_PTR = 0x804D5F94;
+constexpr u32 HSD_GOBJ_PLINK_HEAD = 0x804D782C;
+constexpr u32 GM_80479D58 = 0x80479D58;
+constexpr u32 GAME_CAMERA = 0x80452C68;
+constexpr u32 GAME_CAMERA_SIZE = 0x39C;
+constexpr u32 STAGE_INFO = 0x8049E6C8;
+constexpr u32 STAGE_INFO_SIZE = 0x748;
+constexpr u32 FIGHTER_SIZE = 0x23EC;  // ASSERT_SIZE(struct Fighter, 0x23EC)
+constexpr u32 ITEM_SIZE = 0xFCC;      // ASSERT_SIZE(struct Item, 0xFCC)
+constexpr u32 PLINK_ITEM = 9;         // HSD_GOBJ_PLINK_ITEM
+constexpr u32 MAX_ITEMS = 512;
+
+int s_state = -1;  // -1 unread, 0 off, 1 on
+bool s_wide = false;
+bool s_exit = false;
+FILE* s_out = nullptr;
+s32 s_frame = INT_MIN;
+s32 s_latest = INT_MIN;
+bool s_complete = false;
+s32 s_logged = INT_MIN;
+
+void Init()
+{
+  if (s_state >= 0)
+    return;
+  s_state = 0;
+  const char* path = std::getenv("MELEE_DOLPHIN_NHV1");
+  if (!path || !*path)
+    return;
+  s_out = std::fopen(path, "wb");
+  if (!s_out)
+  {
+    std::fprintf(stderr, "nhv1-oracle: cannot open the output file\n");
+    return;
+  }
+  const char* w = std::getenv("MELEE_DOLPHIN_NHV1_WIDE");
+  s_wide = w && *w && *w != '0';
+  const char* x = std::getenv("MELEE_DOLPHIN_NHV1_EXIT");
+  s_exit = x && *x && *x != '0';
+  std::fwrite("NHRAW001", 1, 8, s_out);
+  const u32 flags = s_wide ? 1 : 0;
+  std::fwrite(&flags, 4, 1, s_out);
+  s_state = 1;
+  std::fprintf(stderr, "nhv1-oracle: on (wide=%d)\n", s_wide ? 1 : 0);
+}
+
+bool InRam(u32 a)
+{
+  return a >= 0x80000000 && a < 0x81800000;
+}
+
+void Put32(std::vector<u8>& b, u32 v)
+{
+  const u8* p = reinterpret_cast<const u8*>(&v);
+  b.insert(b.end(), p, p + 4);
+}
+
+void PutBlob(std::vector<u8>& b, Memory::MemoryManager& mem, u32 addr, u32 size)
+{
+  const size_t at = b.size();
+  b.resize(at + size);
+  mem.CopyFromEmu(b.data() + at, addr, size);
+}
+}  // namespace
+
+bool Enabled()
+{
+  Init();
+  return s_state == 1;
+}
+
+void NoteFrame(s32 frame, s32 latest, bool processing_complete)
+{
+  if (s_state == 1 && (s_frame == INT_MIN || frame < -100 || frame % 1200 == 0))
+    std::fprintf(stderr, "nhv1-oracle: playback frame %d (latest %d)\n", frame, latest);
+  if (s_frame == INT_MIN && s_state == 1 && std::getenv("MELEE_DOLPHIN_NHV1_WATCHDOG"))
+  {
+    std::thread([] {
+      auto& sys = Core::System::GetInstance();
+      for (int i = 0; i < 60; i++)
+      {
+        std::this_thread::sleep_for(std::chrono::seconds(2));
+        std::fprintf(stderr, "nhv1-oracle: watchdog pc=%08x lr=%08x unk0=%u frame=%d\n",
+                     sys.GetPPCState().pc, sys.GetPPCState().spr[8],
+                     sys.GetMemory().Read_U32(GM_80479D58), s_frame);
+        std::fflush(stderr);
+      }
+    }).detach();
+  }
+  s_frame = frame;
+  s_latest = latest;
+  s_complete = processing_complete;
+}
+
+void FrameEnd(const Core::CPUThreadGuard& guard)
+{
+  if (!Enabled())
+    return;
+  static u32 s_calls = 0;
+  if (s_calls++ % 3600 == 0)
+  {
+    std::fprintf(stderr, "nhv1-oracle: hook call %u, playback frame %d\n", s_calls, s_frame);
+    std::fflush(stderr);
+  }
+  if (s_frame == INT_MIN || s_frame == s_logged)
+    return;
+  auto& mem = guard.GetSystem().GetMemory();
+  auto r32 = [&](u32 a) { return PowerPC::MMU::HostRead_U32(guard, a); };
+  auto r8 = [&](u32 a) { return PowerPC::MMU::HostRead_U8(guard, a); };
+
+  std::vector<u8> fighters;
+  u32 n_ft = 0;
+  for (u32 i = 0; i < 6; i++)
+  {
+    const u32 pl = PLAYER_SLOTS + i * PLAYER_SIZE;
+    for (u32 j = 0; j < 2; j++)
+    {
+      // Player_GetEntityAtIndex(i, j) = player_entity[transformed[j]]
+      const u8 t = r8(pl + 0x0C + j);
+      if (t > 1)
+        continue;
+      const u32 g = r32(pl + 0xB0 + 4 * t);
+      if (!InRam(g))
+        continue;
+      const u32 fp = r32(g + 0x2C);  // HSD_GObj::user_data
+      if (!InRam(fp))
+        continue;
+      fighters.push_back(static_cast<u8>(i * 2 + j));
+      fighters.push_back(static_cast<u8>(r32(pl + 0x08)));  // pkind (Gm_PKind_Cpu = 1)
+      fighters.push_back(r8(pl + 0x8E));                     // stocks (s8)
+      fighters.push_back(t);
+      Put32(fighters, fp);
+      PutBlob(fighters, mem, fp, FIGHTER_SIZE);
+      n_ft++;
+    }
+  }
+  if (n_ft == 0)
+  {
+    return;
+  }  // the frame-0 rule: rows start at the first iteration with a fighter
+
+  std::vector<u8> items;
+  u32 n_it = 0;
+  const u32 heads = r32(HSD_GOBJ_PLINK_HEAD);
+  if (InRam(heads))
+  {
+    for (u32 g = r32(heads + 4 * PLINK_ITEM); InRam(g) && n_it < MAX_ITEMS; g = r32(g + 0x08))
+    {
+      const u32 ip = r32(g + 0x2C);
+      if (!InRam(ip))
+        continue;
+      Put32(items, ip);
+      PutBlob(items, mem, ip, ITEM_SIZE);
+      n_it++;
+    }
+  }
+
+  std::vector<u8> rec;
+  Put32(rec, 0x4D524652);  // "RFRM"
+  Put32(rec, static_cast<u32>(s_frame));
+  Put32(rec, r32(GM_80479D58));
+  const u32 seed_ptr = r32(HSD_RAND_SEED_PTR);
+  Put32(rec, InRam(seed_ptr) ? r32(seed_ptr) : 0);
+  Put32(rec, n_ft);
+  Put32(rec, n_it);
+  rec.insert(rec.end(), fighters.begin(), fighters.end());
+  rec.insert(rec.end(), items.begin(), items.end());
+  if (s_wide)
+  {
+    PutBlob(rec, mem, GAME_CAMERA, GAME_CAMERA_SIZE);
+    PutBlob(rec, mem, STAGE_INFO, STAGE_INFO_SIZE);
+  }
+  std::fwrite(rec.data(), 1, rec.size(), s_out);
+  s_logged = s_frame;
+
+  if (s_exit && s_complete && s_frame >= s_latest)
+  {
+    std::fclose(s_out);
+    s_out = nullptr;
+    std::fprintf(stderr, "nhv1-oracle: last frame %d logged, exiting\n", s_frame);
+    std::fflush(stderr);
+    std::_Exit(0);
+  }
+}
+}  // namespace NHV1Oracle
+
+#ifdef _WIN32
+// GD nhv1-oracle: diagnostics for silent fast-fails (write to %TEMP%\nhv1-oracle-crash.txt)
+#include <Windows.h>
+#include <csignal>
+#include <exception>
+namespace
+{
+void CrashNote(const char* what)
+{
+  char path[MAX_PATH];
+  DWORD n = GetTempPathA(MAX_PATH, path);
+  if (n == 0 || n > MAX_PATH - 32)
+    return;
+  strcat_s(path, "nhv1-oracle-crash.txt");
+  FILE* f = nullptr;
+  if (fopen_s(&f, path, "a") != 0 || !f)
+    return;
+  void* frames[48];
+  USHORT k = CaptureStackBackTrace(1, 48, frames, nullptr);
+  const uintptr_t base = reinterpret_cast<uintptr_t>(GetModuleHandleA(nullptr));
+  std::fprintf(f, "%s (exe base %p)\n", what, reinterpret_cast<void*>(base));
+  for (USHORT i = 0; i < k; i++)
+  {
+    HMODULE m = nullptr;
+    GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                       static_cast<LPCSTR>(frames[i]), &m);
+    char mod[MAX_PATH] = "?";
+    if (m)
+      GetModuleFileNameA(m, mod, MAX_PATH);
+    std::fprintf(f, "  %s+0x%llx\n", mod,
+                 static_cast<unsigned long long>(reinterpret_cast<uintptr_t>(frames[i]) - reinterpret_cast<uintptr_t>(m)));
+  }
+  std::fclose(f);
+}
+void OnInvalidParam(const wchar_t* expr, const wchar_t* fn, const wchar_t* file, unsigned line, uintptr_t)
+{
+  char b[512];
+  snprintf(b, sizeof b, "invalid parameter: %ls in %ls (%ls:%u)", expr ? expr : L"?", fn ? fn : L"?",
+           file ? file : L"?", line);
+  CrashNote(b);
+}
+void OnAbort(int)
+{
+  CrashNote("SIGABRT");
+}
+void OnTerminate()
+{
+  try
+  {
+    if (auto e = std::current_exception())
+      std::rethrow_exception(e);
+    CrashNote("terminate, no exception");
+  }
+  catch (const std::exception& e)
+  {
+    char b[512];
+    snprintf(b, sizeof b, "terminate: %s", e.what());
+    CrashNote(b);
+  }
+  catch (...)
+  {
+    CrashNote("terminate: unknown exception");
+  }
+  std::abort();
+}
+struct Install
+{
+  Install()
+  {
+    _set_invalid_parameter_handler(OnInvalidParam);
+    signal(SIGABRT, OnAbort);
+    std::set_terminate(OnTerminate);
+  }
+} s_install;
+}  // namespace
+#endif
diff --git a/Source/Core/Core/Slippi/NHV1Oracle.h b/Source/Core/Core/Slippi/NHV1Oracle.h
