# Up special: a rise you steer with the stick, three quick hits on the way up.
PUT AIR 1
PUT VEL_Y 2.3
wait 1
hitbox slot=0 joint=23 damage=3 size=4.2 x=0 y=2 angle=80 kbg=0 fkb=0 bkb=30
REHIT 1 3
loop 16
GET la_f:0 STICK_X
MUL la_f:0 1.3
PUT VEL_X la_f:0
wait 1
loop_end
REHIT 1 0
clear_hitboxes
wait 6
