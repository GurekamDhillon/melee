     },
     "maxItems": 8
    },
    "on_hit": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/hookRef"
     },
     "maxItems": 8
    }
   },
   "additionalProperties": true
  },
  "attributes": {
   "description": "ftCo_DatAttrs fields by decomp name (index order of geno_attrs[]; the first 40 are v1-v5, the rest append-only from v7). max_jumps is clamped 1..250 by readers; the schema keeps files in range.",
