# Down air: autolink drag-down, 2% per hit every 3 frames
PUT ANIM_RATE 1.0
wait 5
cmd_var idx=0 value=1
wait 6
hitbox slot=0 joint=36 damage=2 size=5.8 x=0 y=0 z=0 angle=270 kbg=100 fkb=0 bkb=0
hitbox slot=1 joint=35 damage=2 size=5.8 x=0 y=0 z=0 angle=270 kbg=100 fkb=0 bkb=0
REHIT 3 3
LINK 3 1
wait 14
REHIT 3 0
LINK 3 0
clear_hitboxes
hitbox slot=0 joint=36 damage=4 size=5.8 x=0 y=0 z=0 angle=290 kbg=70 fkb=0 bkb=25
wait 4
clear_hitboxes
wait 5
cmd_var idx=0 value=0
wait 8
iasa
