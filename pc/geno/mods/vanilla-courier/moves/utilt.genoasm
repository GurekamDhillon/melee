# Up tilt: three quick hits, 3% each, lifts
PUT ANIM_RATE 1.0
wait 5
hitbox slot=0 joint=25 damage=3 size=2.7 x=0 y=0 z=0 angle=100 kbg=120 fkb=0 bkb=15
hitbox slot=1 joint=19 damage=3 size=3.5 x=0 y=0 z=0 angle=100 kbg=120 fkb=0 bkb=15
hitbox slot=2 joint=20 damage=3 size=2.6 x=0 y=0 z=0 angle=100 kbg=120 fkb=0 bkb=15
REHIT 7 4
wait 12
REHIT 7 0
clear_hitboxes
wait 6
iasa
