--- /dev/null
+++ b/Source/Core/Core/Slippi/NHV1Oracle.h
@@ -0,0 +1,29 @@
+// NHV1 oracle (GD's Melee port, local tool, not upstream): dump the GameCube memory that the NHV1 per-frame
+// hash is computed from, once per logic iteration, right after HSD_GObj_RunProcs() returns in gm_801A4D34.
+//
+//   MELEE_DOLPHIN_NHV1=<file.nhraw>   enable; records are appended to that file
+//   MELEE_DOLPHIN_NHV1_WIDE=1         also dump game_camera and stage_info every frame
+//   MELEE_DOLPHIN_NHV1_EXIT=1         exit the process after the replay's last frame was logged
+//
+// Format: see docs/rust-port/notes/dolphin-oracle.md in GD's Melee workspace.
+#pragma once
+
+#include "Common/CommonTypes.h"
+
+namespace Core
+{
+class CPUThreadGuard;
+class System;
+}  // namespace Core
+
+namespace NHV1Oracle
+{
+// the instruction after `bl HSD_GObj_RunProcs` in gm_801A4D34 (NTSC 1.02)
+constexpr u32 HOOK_ADDRESS = 0x801A4FA4;
+
+bool Enabled();
+// HLE hook body (HookType::Start, HookFlag::Fixed)
+void FrameEnd(const Core::CPUThreadGuard& guard);
+// called by the Slippi EXI device when it hands a playback frame to the game
+void NoteFrame(s32 frame, s32 latest, bool processing_complete);
+}  // namespace NHV1Oracle
